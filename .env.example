# ===== Discord 設定 =====
# Discord Developer Portal で取得したBOTトークン
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE
# 通知を送るチャンネルのID（数字のみ）
CHANNEL_ID=000000000000000000

# ===== The Odds API 設定 =====
# https://the-odds-api.com で取得したAPIキー
ODDS_API_KEY=YOUR_ODDS_API_KEY_HERE

# ===== データベース 設定 =====
# SQLite を使う場合（ファイル1つで完結。Phase1の標準）
DATABASE_URL=sqlite:///./data/odds_research.db
# 将来 PostgreSQL に移行する場合の例:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/odds_research
